function projectRoot = find_project_root(startDir)
    % Walk upward until we find a folder that contains BOTH "data" and "matlab_project"
    root = startDir;
    maxUp = 20;
    for k = 1:maxUp
        if isfolder(fullfile(root,"data")) && isfolder(fullfile(root,"matlab_project"))
            projectRoot = root;
            return;
        end
        parent = fileparts(root);
        if strcmp(parent, root)
            break;
        end
        root = parent;
    end
    % If not found, fall back to one level up (common case)
    projectRoot = fileparts(startDir);
end

function flh = read_flh_scalar(fname)
    % Robustly read a scalar FLH from a "two-column-ish" csv (index + value),
    % or a repeated column of the same scalar.
    if ~isfile(fname)
        error("Missing file: %s", fname);
    end

    % Use readtable to survive headers/indices
    T = readtable(fname, "PreserveVariableNames", true);

    % Collect numeric candidates
    vals = [];
    for j = 1:width(T)
        col = T{:,j};
        if isnumeric(col) || islogical(col)
            vals = [vals; col(:)];
        else
            % try convert strings
            if iscellstr(col) || isstring(col)
                x = str2double(string(col));
                vals = [vals; x(:)];
            end
        end
    end

    vals = vals(isfinite(vals));
    if isempty(vals)
        error("Could not parse numeric FLH from %s", fname);
    end

    % Many files repeat same scalar (e.g. 2500). Use mode-like rule:
    % choose the most frequent rounded value.
    vround = round(vals);
    u = unique(vround);
    counts = zeros(size(u));
    for k = 1:numel(u)
        counts(k) = sum(vround == u(k));
    end
    [~, imax] = max(counts);
    flh = double(u(imax));

    if ~isfinite(flh) || flh <= 0
        error("Invalid FLH parsed from %s (value=%g).", fname, flh);
    end
end

function [Aeq, beq, Aineq, bineq] = build_constraints( ...
        Ai_tail, Ai_head, Ap, D0, sAp, sD, ...
        a_therm, b_therm, l, Qmax, ...
        E, N, nVar, idxQin, idxQout, idxQp, idxLam, pairs)

    % Apply signs (if caller wants to try combos)
    D  = sD  * D0;
    Ap = sAp * Ap;

    % Pipe equalities:
    % (1-a*l)Qin - Qout - (b*l)lam = 0
    Aeq_pipe = sparse(E, nVar);
    beq_pipe = zeros(E,1);
    Aeq_pipe(:, idxQin)  = spdiags(1 - a_therm*l, 0, E, E);
    Aeq_pipe(:, idxQout) = -speye(E);
    Aeq_pipe(:, idxLam)  = spdiags(-b_therm*l, 0, E, E);

    % Node equalities:
    % Ai_tail*Qin - Ai_head*Qout + Ap*Qp = D
    Aeq_node = sparse(N, nVar);
    beq_node = D;
    Aeq_node(:, idxQin) = Ai_tail;
    Aeq_node(:, idxQout)= -Ai_head;
    Aeq_node(:, idxQp)  = Ap;

    Aeq = [Aeq_pipe; Aeq_node];
    beq = [beq_pipe; beq_node];

    % Big-M: Qin <= Qmax * lam
    Aineq_M = sparse(E, nVar);
    bineq_M = zeros(E,1);
    Aineq_M(:, idxQin) = speye(E);
    Aineq_M(:, idxLam) = -Qmax*speye(E);

    % Anti-parallel: lam_e + lam_rev <= 1
    mPair = size(pairs,1);
    if mPair == 0
        Aineq_pair = sparse(0,nVar);
        bineq_pair = zeros(0,1);
    else
        rows = repelem((1:mPair)', 2, 1);
        cols = [idxLam(pairs(:,1)); idxLam(pairs(:,2))];
        vals = ones(2*mPair,1);
        Aineq_pair = sparse(rows, cols, vals, mPair, nVar);
        bineq_pair = ones(mPair,1);
    end

    Aineq = [Aineq_M; Aineq_pair];
    bineq = [bineq_M; bineq_pair];
end
